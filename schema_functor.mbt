///|
// Strictly positive functor descriptors, constructor constraints, and
// induction-recursive decoding for generated inductive families.
//
// A `DPositiveFunctor` is a finite syntax for the strictly positive
// endofunctors generated by identity, external constants, products,
// sums, lists, Pi over an external domain, and dependent polynomial
// containers.  Containers subsume the usual strictly positive
// polynomial presentations.  The three operations
// below generate, uniformly in the descriptor:
//
//   * the semantic type `F X`;
//   * the induction-hypothesis type `All_F P x`; and
//   * the map which constructs an element of that All-type by
//     applying the eliminator at every recursive occurrence.
//
// Constructor constraints are propositional Path side conditions.
// They are checked at introductions and are passed as final Path
// arguments to generated eliminator cases.
//
// If an inductive spec has decode cases, its constructors are codes
// and `eval_inductive_decode` is the simultaneously defined decoding
// function.  Neutral codes decode to a dedicated neutral type, so a
// decoded domain remains available under binders.

///|
pub fn schema_value_prefix(values : Array[DValue], n : Int32) -> Array[DValue] {
  let out : Array[DValue] = []
  for i in 0..<n {
    if i < values.length() {
      out.push(values[i])
    }
  }
  out
}

///|
pub fn schema_arg_spec_prefix(
  args : Array[DConstructorArg],
  n : Int32,
) -> Array[DConstructorArg] {
  let out : Array[DConstructorArg] = []
  for i in 0..<n {
    if i < args.length() {
      out.push(args[i])
    }
  }
  out
}

///|
fn schema_source_indices(
  arg : DConstructorArg,
  prior_specs : Array[DConstructorArg],
  params : Array[DValue],
  prior : Array[DValue],
) -> Array[DValue] {
  if arg.target < 0 || arg.target >= prior_specs.length() {
    []
  } else {
    let source = prior_specs[arg.target]
    match source.kind {
      DArgRecursive =>
        schema_eval_index_terms(
          params,
          schema_value_prefix(prior, arg.target),
          source.index,
        )
      _ => []
    }
  }
}

///|
fn schema_source_value(arg : DConstructorArg, prior : Array[DValue]) -> DValue {
  if arg.target >= 0 && arg.target < prior.length() {
    prior[arg.target]
  } else {
    DVUnit
  }
}

///|
fn positive_sum_family(a : DValue, b : DValue) -> (DValue) -> DValue {
  tag => {
    match force_value(tag) {
      DVBool(true) => a
      DVBool(false) => b
      DVNeutral(n) => DVNeutral(DNBoolElim(_ => DVUniv(0), a, b, n))
      _ => DVUnitTy
    }
  }
}

///|
/// The semantic type obtained by applying a positive functor to an
/// indexed family.
pub fn positive_functor_type(
  functor : DPositiveFunctor,
  params : Array[DValue],
  prior : Array[DValue],
  family : (Array[DValue]) -> DValue,
) -> DValue {
  match functor {
    DFunctorIdentity(index) =>
      family(schema_eval_index_terms(params, prior, index))
    DFunctorConst(ty) =>
      schema_eval_under(ty, schema_concat_values(params, prior), [])
    DFunctorProduct(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb = positive_functor_type(b, params, prior, family)
      DVSigma(ta, _ => tb)
    }
    DFunctorSum(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb = positive_functor_type(b, params, prior, family)
      DVSigma(DVBoolTy, positive_sum_family(ta, tb))
    }
    DFunctorList(inner) =>
      DVListTy(positive_functor_type(inner, params, prior, family))
    DFunctorContainer(shape, positions, index) => {
      let shape_ty = schema_eval_under(
        shape,
        schema_concat_values(params, prior),
        [],
      )
      DVSigma(shape_ty, s => {
        let prior_s = schema_concat_values(prior, [s])
        let pos_ty = schema_eval_under(
          positions,
          schema_concat_values(params, prior_s),
          [],
        )
        DVPi(pos_ty, p => {
          family(
            schema_eval_index_terms(
              params,
              schema_concat_values(prior_s, [p]),
              index,
            ),
          )
        })
      })
    }
    DFunctorPi(dom, inner) => {
      let dv = schema_eval_under(dom, schema_concat_values(params, prior), [])
      DVPi(dv, a => {
        positive_functor_type(
          inner,
          params,
          schema_concat_values(prior, [a]),
          family,
        )
      })
    }
  }
}

///|
/// The type of eliminator results at all recursive occurrences in a
/// value of `F X`.  Constants contribute Unit; lists contribute the
/// dependent All-type, represented recursively by nested Sigmas.
pub fn positive_functor_ih_type(
  functor : DPositiveFunctor,
  params : Array[DValue],
  prior : Array[DValue],
  family : (Array[DValue]) -> DValue,
  motive : (Array[DValue], DValue) -> DValue,
  value : DValue,
) -> DValue {
  match functor {
    DFunctorIdentity(index) =>
      motive(schema_eval_index_terms(params, prior, index), value)
    DFunctorConst(_) => DVUnitTy
    DFunctorProduct(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb = positive_functor_type(b, params, prior, family)
      let x = dfst_typed(value, _ => tb)
      let y = dsnd_typed(value, ta, _ => tb)
      DVSigma(positive_functor_ih_type(a, params, prior, family, motive, x), _ => {
        positive_functor_ih_type(b, params, prior, family, motive, y)
      })
    }
    DFunctorSum(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb = positive_functor_type(b, params, prior, family)
      let fam = positive_sum_family(ta, tb)
      let tag = dfst_typed(value, fam)
      let payload = dsnd_typed(value, DVBoolTy, fam)
      match force_value(tag) {
        DVBool(true) =>
          positive_functor_ih_type(a, params, prior, family, motive, payload)
        DVBool(false) =>
          positive_functor_ih_type(b, params, prior, family, motive, payload)
        _ =>
          eval_bool_elim(
            _ => DVUniv(0),
            positive_functor_ih_type(a, params, prior, family, motive, payload),
            positive_functor_ih_type(b, params, prior, family, motive, payload),
            tag,
            0,
          )
      }
    }
    DFunctorList(inner) => {
      let elem = positive_functor_type(inner, params, prior, family)
      let step : DValue = DVLam(x => {
        DVLam(_xs => {
          DVLam(ih => {
            DVSigma(
              positive_functor_ih_type(inner, params, prior, family, motive, x),
              _ => ih,
            )
          })
        })
      })
      eval_list_elim(elem, _ => DVUniv(0), DVUnitTy, step, value, 0)
    }
    DFunctorContainer(shape, positions, index) => {
      let shape_ty = schema_eval_under(
        shape,
        schema_concat_values(params, prior),
        [],
      )
      let branch : (DValue) -> DValue = s => {
        let prior_s = schema_concat_values(prior, [s])
        let pos_ty = schema_eval_under(
          positions,
          schema_concat_values(params, prior_s),
          [],
        )
        DVPi(pos_ty, p => {
          family(
            schema_eval_index_terms(
              params,
              schema_concat_values(prior_s, [p]),
              index,
            ),
          )
        })
      }
      let s = dfst_typed(value, branch)
      let contents = dsnd_typed(value, shape_ty, branch)
      let prior_s = schema_concat_values(prior, [s])
      let pos_ty = schema_eval_under(
        positions,
        schema_concat_values(params, prior_s),
        [],
      )
      DVPi(pos_ty, p => {
        motive(
          schema_eval_index_terms(
            params,
            schema_concat_values(prior_s, [p]),
            index,
          ),
          dapp_typed(contents, p, pos_ty),
        )
      })
    }
    DFunctorPi(dom, inner) => {
      let dv = schema_eval_under(dom, schema_concat_values(params, prior), [])
      DVPi(dv, a => {
        positive_functor_ih_type(
          inner,
          params,
          schema_concat_values(prior, [a]),
          family,
          motive,
          dapp_typed(value, a, dv),
        )
      })
    }
  }
}

///|
/// Apply an eliminator at every recursive occurrence, producing a
/// value of `positive_functor_ih_type`.
pub fn positive_functor_map(
  functor : DPositiveFunctor,
  params : Array[DValue],
  prior : Array[DValue],
  family : (Array[DValue]) -> DValue,
  motive : (Array[DValue], DValue) -> DValue,
  elim : (Array[DValue], DValue) -> DValue,
  value : DValue,
) -> DValue {
  match functor {
    DFunctorIdentity(index) =>
      elim(schema_eval_index_terms(params, prior, index), value)
    DFunctorConst(_) => DVUnit
    DFunctorProduct(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb = positive_functor_type(b, params, prior, family)
      let x = dfst_typed(value, _ => tb)
      let y = dsnd_typed(value, ta, _ => tb)
      DVPair(
        positive_functor_map(a, params, prior, family, motive, elim, x),
        positive_functor_map(b, params, prior, family, motive, elim, y),
      )
    }
    DFunctorSum(a, b) => {
      let ta = positive_functor_type(a, params, prior, family)
      let tb = positive_functor_type(b, params, prior, family)
      let fam = positive_sum_family(ta, tb)
      let tag = dfst_typed(value, fam)
      let payload = dsnd_typed(value, DVBoolTy, fam)
      match force_value(tag) {
        DVBool(true) =>
          positive_functor_map(a, params, prior, family, motive, elim, payload)
        DVBool(false) =>
          positive_functor_map(b, params, prior, family, motive, elim, payload)
        _ =>
          eval_bool_elim(
            t => {
              positive_functor_ih_type(
                DFunctorSum(a, b),
                params,
                prior,
                family,
                motive,
                DVPair(t, payload),
              )
            },
            positive_functor_map(
              a, params, prior, family, motive, elim, payload,
            ),
            positive_functor_map(
              b, params, prior, family, motive, elim, payload,
            ),
            tag,
            0,
          )
      }
    }
    DFunctorList(inner) => {
      let elem = positive_functor_type(inner, params, prior, family)
      let step : DValue = DVLam(x => {
        DVLam(_xs => {
          DVLam(ih => {
            DVPair(
              positive_functor_map(
                inner, params, prior, family, motive, elim, x,
              ),
              ih,
            )
          })
        })
      })
      eval_list_elim(
        elem,
        xs => {
          positive_functor_ih_type(
            DFunctorList(inner),
            params,
            prior,
            family,
            motive,
            xs,
          )
        },
        DVUnit,
        step,
        value,
        0,
      )
    }
    DFunctorContainer(shape, positions, index) => {
      let shape_ty = schema_eval_under(
        shape,
        schema_concat_values(params, prior),
        [],
      )
      let branch : (DValue) -> DValue = s => {
        let prior_s = schema_concat_values(prior, [s])
        let pos_ty = schema_eval_under(
          positions,
          schema_concat_values(params, prior_s),
          [],
        )
        DVPi(pos_ty, p => {
          family(
            schema_eval_index_terms(
              params,
              schema_concat_values(prior_s, [p]),
              index,
            ),
          )
        })
      }
      let s = dfst_typed(value, branch)
      let contents = dsnd_typed(value, shape_ty, branch)
      let prior_s = schema_concat_values(prior, [s])
      let pos_ty = schema_eval_under(
        positions,
        schema_concat_values(params, prior_s),
        [],
      )
      DVLam(p => {
        elim(
          schema_eval_index_terms(
            params,
            schema_concat_values(prior_s, [p]),
            index,
          ),
          dapp_typed(contents, p, pos_ty),
        )
      })
    }
    DFunctorPi(dom, inner) => {
      let dv = schema_eval_under(dom, schema_concat_values(params, prior), [])
      DVLam(a => {
        positive_functor_map(
          inner,
          params,
          schema_concat_values(prior, [a]),
          family,
          motive,
          elim,
          dapp_typed(value, a, dv),
        )
      })
    }
  }
}

///|
fn positive_functor_validate(
  functor : DPositiveFunctor,
  family_name : String,
  params : Array[DTelescopeEntry],
  indices : Array[DTelescopeEntry],
  prefix_types : Array[DValue],
  prefix_values : Array[DValue],
) -> DValue? {
  match functor {
    DFunctorIdentity(index) =>
      if schema_check_index_terms(
          indices, params, prefix_types, prefix_values, index,
        ) {
        Some(DVUnitTy)
      } else {
        None
      }
    DFunctorConst(ty) => {
      if schema_term_mentions_family(ty, family_name) {
        return None
      }
      match
        d_as_type(
          ty,
          schema_env(prefix_types),
          schema_env(prefix_values),
          ddim_empty(),
        ) {
        Some(tv) => Some(tv.value)
        None => None
      }
    }
    DFunctorProduct(a, b) =>
      match
        (
          positive_functor_validate(
            a, family_name, params, indices, prefix_types, prefix_values,
          ),
          positive_functor_validate(
            b, family_name, params, indices, prefix_types, prefix_values,
          ),
        ) {
        (Some(ta), Some(tb)) => Some(DVSigma(ta, _ => tb))
        _ => None
      }
    DFunctorSum(a, b) =>
      match
        (
          positive_functor_validate(
            a, family_name, params, indices, prefix_types, prefix_values,
          ),
          positive_functor_validate(
            b, family_name, params, indices, prefix_types, prefix_values,
          ),
        ) {
        (Some(ta), Some(tb)) =>
          Some(DVSigma(DVBoolTy, positive_sum_family(ta, tb)))
        _ => None
      }
    DFunctorList(inner) =>
      match
        positive_functor_validate(
          inner, family_name, params, indices, prefix_types, prefix_values,
        ) {
        Some(t) => Some(DVListTy(t))
        None => None
      }
    DFunctorContainer(shape, positions, index) => {
      if schema_term_mentions_family(shape, family_name) ||
        schema_term_mentions_family(positions, family_name) {
        return None
      }
      match
        d_as_type(
          shape,
          schema_env(prefix_types),
          schema_env(prefix_values),
          ddim_empty(),
        ) {
        Some(shape_tv) => {
          let shape_types = schema_concat_values(prefix_types, [shape_tv.value])
          let shape_values = schema_concat_values(prefix_values, [
            DVNeutral(DNVar(9300 + prefix_values.length())),
          ])
          match
            d_as_type(
              positions,
              schema_env(shape_types),
              schema_env(shape_values),
              ddim_empty(),
            ) {
            Some(pos_tv) => {
              let index_types = schema_concat_values(shape_types, [pos_tv.value])
              let index_values = schema_concat_values(shape_values, [
                DVNeutral(DNVar(9400 + prefix_values.length())),
              ])
              if schema_check_index_terms(
                  indices, params, index_types, index_values, index,
                ) {
                Some(
                  DVSigma(shape_tv.value, s => {
                    DVPi(
                      schema_eval_under(
                        positions,
                        schema_concat_values(prefix_values, [s]),
                        [],
                      ),
                      _ => DVUnitTy,
                    )
                  }),
                )
              } else {
                None
              }
            }
            None => None
          }
        }
        None => None
      }
    }
    DFunctorPi(dom, inner) => {
      if schema_term_mentions_family(dom, family_name) {
        return None
      }
      match
        d_as_type(
          dom,
          schema_env(prefix_types),
          schema_env(prefix_values),
          ddim_empty(),
        ) {
        Some(tv) => {
          let inner_types = schema_concat_values(prefix_types, [tv.value])
          let inner_values = schema_concat_values(prefix_values, [
            DVNeutral(DNVar(9100 + prefix_values.length())),
          ])
          match
            positive_functor_validate(
              inner, family_name, params, indices, inner_types, inner_values,
            ) {
            Some(_) =>
              Some(
                DVPi(tv.value, a => {
                  match
                    positive_functor_validate(
                      inner,
                      family_name,
                      params,
                      indices,
                      schema_concat_values(prefix_types, [tv.value]),
                      schema_concat_values(prefix_values, [a]),
                    ) {
                    Some(t) => t
                    None => DVUnitTy
                  }
                }),
              )
            None => None
          }
        }
        None => None
      }
    }
  }
}

///|
/// Full form of `schema_arg_type`, with earlier argument descriptors
/// and an induction-recursive decoding function available.
pub fn schema_arg_type_full(
  arg : DConstructorArg,
  prior_specs : Array[DConstructorArg],
  params : Array[DValue],
  prior : Array[DValue],
  family : (Array[DValue]) -> DValue,
  decode : (Array[DValue], DValue) -> DValue,
) -> DValue {
  match arg.kind {
    DArgExternal =>
      schema_eval_under(arg.ty, schema_concat_values(params, prior), [])
    DArgRecursive => family(schema_eval_index_terms(params, prior, arg.index))
    DArgFunction => {
      let dom = schema_eval_under(arg.ty, schema_concat_values(params, prior), [])
      DVPi(dom, a => {
        family(
          schema_eval_index_terms(
            params,
            schema_concat_values(prior, [a]),
            arg.index,
          ),
        )
      })
    }
    DArgNested => positive_functor_type(arg.nested, params, prior, family)
    DArgDecoded =>
      decode(
        schema_source_indices(arg, prior_specs, params, prior),
        schema_source_value(arg, prior),
      )
    DArgDecodedFunction => {
      let dom = decode(
        schema_source_indices(arg, prior_specs, params, prior),
        schema_source_value(arg, prior),
      )
      DVPi(dom, a => {
        family(
          schema_eval_index_terms(
            params,
            schema_concat_values(prior, [a]),
            arg.index,
          ),
        )
      })
    }
  }
}

///|
pub fn inductive_arg_type_full(
  spec : DInductiveSpec,
  arg : DConstructorArg,
  prior_specs : Array[DConstructorArg],
  params : Array[DValue],
  prior : Array[DValue],
) -> DValue {
  schema_arg_type_full(
    arg,
    prior_specs,
    params,
    prior,
    idx => DVInductive(spec, params, idx),
    (idx, code) => eval_inductive_decode(spec, params, idx, code, 0),
  )
}

///|
/// Evaluate the type and endpoints of one constructor constraint.
pub fn schema_constraint_parts(
  constraint : DConstructorConstraint,
  params : Array[DValue],
  args : Array[DValue],
) -> (DValue, DValue, DValue) {
  let values = schema_concat_values(params, args)
  (
    schema_eval_under(constraint.ty, values, []),
    schema_eval_under(constraint.lhs, values, []),
    schema_eval_under(constraint.rhs, values, []),
  )
}

///|
pub fn schema_constraints_hold(
  level : Int32,
  dlevel : Int32,
  constraints : Array[DConstructorConstraint],
  params : Array[DValue],
  args : Array[DValue],
) -> Bool {
  for i in 0..<constraints.length() {
    let (ty, lhs, rhs) = schema_constraint_parts(constraints[i], params, args)
    if !conv_at(level, dlevel, ty, lhs, rhs) {
      return false
    }
  }
  true
}

///|
fn schema_constraints_pi_loop(
  constraints : Array[DConstructorConstraint],
  pos : Int32,
  params : Array[DValue],
  args : Array[DValue],
  rest : DValue,
) -> DValue {
  if pos >= constraints.length() {
    rest
  } else {
    let (ty, lhs, rhs) = schema_constraint_parts(constraints[pos], params, args)
    DVPi(DVPathTy(_ => ty, lhs, rhs), _ => {
      schema_constraints_pi_loop(constraints, pos + 1, params, args, rest)
    })
  }
}

///|
/// Prefix a case type by Path arguments for all constraints.
pub fn schema_constraints_pi(
  constraints : Array[DConstructorConstraint],
  params : Array[DValue],
  args : Array[DValue],
  rest : DValue,
) -> DValue {
  schema_constraints_pi_loop(constraints, 0, params, args, rest)
}

///|
/// Supply reflexivity proofs for the (checked) constraints of a
/// canonical introduction.
pub fn schema_apply_constraint_proofs(
  case_value : DValue,
  constraints : Array[DConstructorConstraint],
  params : Array[DValue],
  args : Array[DValue],
) -> DValue {
  let mut cur = case_value
  for i in 0..<constraints.length() {
    let (ty, lhs, rhs) = schema_constraint_parts(constraints[i], params, args)
    cur = dapp_typed(cur, DVPathLam(_ => lhs), DVPathTy(_ => ty, lhs, rhs))
  }
  cur
}

///|
pub fn conv_schema_args_full(
  level : Int32,
  dlevel : Int32,
  args : Array[DConstructorArg],
  params : Array[DValue],
  family : (Array[DValue]) -> DValue,
  decode : (Array[DValue], DValue) -> DValue,
  a : Array[DValue],
  b : Array[DValue],
) -> Bool {
  if a.length() != b.length() || a.length() != args.length() {
    return false
  }
  let prior : Array[DValue] = []
  for i in 0..<a.length() {
    let ty = schema_arg_type_full(
      args[i],
      schema_arg_spec_prefix(args, i),
      params,
      prior,
      family,
      decode,
    )
    if !conv_at(level, dlevel, ty, a[i], b[i]) {
      return false
    }
    prior.push(a[i])
  }
  true
}

///|
pub fn quote_schema_args_full(
  level : Int32,
  dlevel : Int32,
  args : Array[DConstructorArg],
  params : Array[DValue],
  family : (Array[DValue]) -> DValue,
  decode : (Array[DValue], DValue) -> DValue,
  values : Array[DValue],
) -> Array[DTerm] {
  let out : Array[DTerm] = []
  let prior : Array[DValue] = []
  for i in 0..<values.length() {
    let ty = if i < args.length() {
      schema_arg_type_full(
        args[i],
        schema_arg_spec_prefix(args, i),
        params,
        prior,
        family,
        decode,
      )
    } else {
      DVUnitTy
    }
    out.push(quote_at(level, dlevel, ty, values[i]))
    prior.push(values[i])
  }
  out
}

// ---------------------------------------------------------------------------
// Induction-recursion: decoding
// ---------------------------------------------------------------------------

///|
/// Decode a code of an induction-recursive family.  Canonical codes
/// compute by their decode case; neutral codes give a neutral decoded
/// type; formal compositions are mapped through the universe.
pub fn eval_inductive_decode(
  spec : DInductiveSpec,
  params : Array[DValue],
  indices : Array[DValue],
  code : DValue,
  dlevel : Int32,
) -> DValue {
  if spec.decode_cases.length() == 0 {
    return DVUnitTy
  }
  match force_value(code) {
    DVIntro(spec2, ctor, params2, args) =>
      if spec2 != spec ||
        ctor < 0 ||
        ctor >= spec.constructors.length() ||
        ctor >= spec.decode_cases.length() {
        DVUnitTy
      } else {
        let ctor_spec = spec.constructors[ctor]
        let env_values : Array[DValue] = []
        for i in 0..<params2.length() {
          env_values.push(params2[i])
        }
        let prior : Array[DValue] = []
        for i in 0..<args.length() {
          if i >= ctor_spec.args.length() {
            break
          }
          let arg_spec = ctor_spec.args[i]
          let arg = args[i]
          env_values.push(arg)
          match arg_spec.kind {
            DArgRecursive => {
              let idx = schema_eval_index_terms(params2, prior, arg_spec.index)
              env_values.push(
                eval_inductive_decode(spec, params2, idx, arg, dlevel),
              )
            }
            DArgFunction => {
              let dom = schema_eval_under(
                arg_spec.ty,
                schema_concat_values(params2, prior),
                [],
              )
              let prior_copy = schema_concat_values([], prior)
              env_values.push(
                DVLam(a => {
                  let idx = schema_eval_index_terms(
                    params2,
                    schema_concat_values(prior_copy, [a]),
                    arg_spec.index,
                  )
                  eval_inductive_decode(
                    spec,
                    params2,
                    idx,
                    dapp_typed(arg, a, dom),
                    dlevel,
                  )
                }),
              )
            }
            DArgNested =>
              env_values.push(
                positive_functor_map(
                  arg_spec.nested,
                  params2,
                  prior,
                  idx => DVInductive(spec, params2, idx),
                  (_, _) => DVUniv(spec.decode_level),
                  (idx, x) => {
                    eval_inductive_decode(spec, params2, idx, x, dlevel)
                  },
                  arg,
                ),
              )
            DArgDecodedFunction => {
              let prior_specs = schema_arg_spec_prefix(ctor_spec.args, i)
              let source_idx = schema_source_indices(
                arg_spec, prior_specs, params2, prior,
              )
              let dom = eval_inductive_decode(
                spec,
                params2,
                source_idx,
                schema_source_value(arg_spec, prior),
                dlevel,
              )
              let prior_copy = schema_concat_values([], prior)
              env_values.push(
                DVLam(a => {
                  let idx = schema_eval_index_terms(
                    params2,
                    schema_concat_values(prior_copy, [a]),
                    arg_spec.index,
                  )
                  eval_inductive_decode(
                    spec,
                    params2,
                    idx,
                    dapp_typed(arg, a, dom),
                    dlevel,
                  )
                }),
              )
            }
            DArgExternal | DArgDecoded => ()
          }
          prior.push(arg)
        }
        for i in 0..<ctor_spec.constraints.length() {
          let (_, lhs, _) = schema_constraint_parts(
            ctor_spec.constraints[i],
            params2,
            args,
          )
          env_values.push(DVPathLam(_ => lhs))
        }
        deval_dim(spec.decode_cases[ctor], schema_env(env_values), ddim_empty())
      }
    DVNeutral(DNComp(line, branches, base)) =>
      elim_over_comp(
        line,
        branches,
        base,
        _ => DVUniv(spec.decode_level),
        v => eval_inductive_decode(spec, params, indices, v, dlevel),
        dlevel,
      )
    DVNeutral(DNHComp(ty, branches, base)) =>
      elim_over_comp(
        _ => ty,
        branches,
        base,
        _ => DVUniv(spec.decode_level),
        v => eval_inductive_decode(spec, params, indices, v, dlevel),
        dlevel,
      )
    DVNeutral(n) => DVNeutral(DNDecode(spec, params, indices, n))
    _ => DVUnitTy
  }
}

///|
pub fn eval_decode_term(
  spec : DInductiveSpec,
  param_terms : Array[DTerm],
  index_terms : Array[DTerm],
  code : DTerm,
  env : DEnv,
  denv : DDimEnv,
) -> DValue {
  let params : Array[DValue] = []
  for i in 0..<param_terms.length() {
    params.push(deval_dim(param_terms[i], env, denv))
  }
  let indices : Array[DValue] = []
  for i in 0..<index_terms.length() {
    indices.push(deval_dim(index_terms[i], env, denv))
  }
  eval_inductive_decode(
    spec,
    params,
    indices,
    deval_dim(code, env, denv),
    ddim_len(denv),
  )
}

///|
pub fn infer_decode(
  spec : DInductiveSpec,
  param_terms : Array[DTerm],
  index_terms : Array[DTerm],
  code : DTerm,
  ctx : DEnv,
  env : DEnv,
  denv : DDimEnv,
) -> DInfer? {
  if !inductive_schema_validate(spec) || spec.decode_cases.length() == 0 {
    return None
  }
  match
    check_telescope_terms(spec.params, param_terms, [], [], ctx, env, denv) {
    Some(params) =>
      match
        check_telescope_terms(
          spec.indices,
          index_terms,
          inductive_param_types(spec, params),
          params,
          ctx,
          env,
          denv,
        ) {
        Some(indices) =>
          match
            d_check(code, DVInductive(spec, params, indices), ctx, env, denv) {
            Some(code_value) =>
              Some(DInfer::{
                value: eval_inductive_decode(
                  spec,
                  params,
                  indices,
                  code_value,
                  ddim_len(denv),
                ),
                ty: DVUniv(spec.decode_level),
              })
            None => None
          }
        None => None
      }
    None => None
  }
}

///|
pub fn quote_decode_neutral(
  level : Int32,
  dlevel : Int32,
  spec : DInductiveSpec,
  params : Array[DValue],
  indices : Array[DValue],
  code : DNeutral,
) -> DTerm {
  DDecode(
    spec,
    quote_telescope_values(level, dlevel, spec.params, [], [], params),
    quote_telescope_values(
      level,
      dlevel,
      spec.indices,
      inductive_param_types(spec, params),
      params,
      indices,
    ),
    quote_dneutral(level, dlevel, code, DVInductive(spec, params, indices)),
  )
}

///|
pub fn conv_decode_neutral(
  level : Int32,
  dlevel : Int32,
  s1 : DInductiveSpec,
  p1 : Array[DValue],
  i1 : Array[DValue],
  n1 : DNeutral,
  s2 : DInductiveSpec,
  p2 : Array[DValue],
  i2 : Array[DValue],
  n2 : DNeutral,
) -> Bool {
  s1 == s2 &&
  conv_telescope_values(level, dlevel, s1.params, [], [], p1, p2) &&
  conv_telescope_values(
    level,
    dlevel,
    s1.indices,
    inductive_param_types(s1, p1),
    p1,
    i1,
    i2,
  ) &&
  conv_neutral(level, dlevel, n1, n2)
}

///|
/// The AST form of the decoding function.
pub fn decode_term(
  spec : DInductiveSpec,
  params : Array[DTerm],
  indices : Array[DTerm],
  code : DTerm,
) -> DTerm {
  DDecode(spec, params, indices, code)
}

///|
/// Check every decode case as a type-valued term in the context of
/// parameters, arguments, recursive decode hypotheses and constraint
/// proofs.
pub fn inductive_decode_cases_validate(spec : DInductiveSpec) -> Bool {
  if spec.decode_cases.length() == 0 {
    return true
  }
  if spec.decode_cases.length() != spec.constructors.length() ||
    spec.decode_level < 0 {
    return false
  }
  let param_values = schema_fresh_values(spec.params.length(), 8600)
  let param_types = inductive_param_types(spec, param_values)
  for c in 0..<spec.constructors.length() {
    let ctor = spec.constructors[c]
    let types : Array[DValue] = []
    let values : Array[DValue] = []
    for i in 0..<param_types.length() {
      types.push(param_types[i])
      values.push(param_values[i])
    }
    let prior : Array[DValue] = []
    for i in 0..<ctor.args.length() {
      let arg = ctor.args[i]
      let prior_specs = schema_arg_spec_prefix(ctor.args, i)
      let arg_ty = inductive_arg_type_full(
        spec, arg, prior_specs, param_values, prior,
      )
      let fresh = DVNeutral(DNVar(8700 + c * 40 + i))
      types.push(arg_ty)
      values.push(fresh)
      match arg.kind {
        DArgRecursive => {
          let idx = schema_eval_index_terms(param_values, prior, arg.index)
          types.push(DVUniv(spec.decode_level))
          values.push(eval_inductive_decode(spec, param_values, idx, fresh, 0))
        }
        DArgFunction => {
          let dom = schema_eval_under(
            arg.ty,
            schema_concat_values(param_values, prior),
            [],
          )
          types.push(DVPi(dom, _ => DVUniv(spec.decode_level)))
          values.push(
            DVLam(a => {
              let idx = schema_eval_index_terms(
                param_values,
                schema_concat_values(prior, [a]),
                arg.index,
              )
              eval_inductive_decode(
                spec,
                param_values,
                idx,
                dapp_typed(fresh, a, dom),
                0,
              )
            }),
          )
        }
        DArgNested => {
          types.push(
            positive_functor_ih_type(
              arg.nested,
              param_values,
              prior,
              idx => DVInductive(spec, param_values, idx),
              (_, _) => DVUniv(spec.decode_level),
              fresh,
            ),
          )
          values.push(
            positive_functor_map(
              arg.nested,
              param_values,
              prior,
              idx => DVInductive(spec, param_values, idx),
              (_, _) => DVUniv(spec.decode_level),
              (idx, x) => eval_inductive_decode(spec, param_values, idx, x, 0),
              fresh,
            ),
          )
        }
        DArgDecodedFunction => {
          let dom = eval_inductive_decode(
            spec,
            param_values,
            schema_source_indices(arg, prior_specs, param_values, prior),
            schema_source_value(arg, prior),
            0,
          )
          types.push(DVPi(dom, _ => DVUniv(spec.decode_level)))
          values.push(
            DVLam(a => {
              let idx = schema_eval_index_terms(
                param_values,
                schema_concat_values(prior, [a]),
                arg.index,
              )
              eval_inductive_decode(
                spec,
                param_values,
                idx,
                dapp_typed(fresh, a, dom),
                0,
              )
            }),
          )
        }
        DArgExternal | DArgDecoded => ()
      }
      prior.push(fresh)
    }
    for i in 0..<ctor.constraints.length() {
      let (ty, lhs, rhs) = schema_constraint_parts(
        ctor.constraints[i],
        param_values,
        prior,
      )
      types.push(DVPathTy(_ => ty, lhs, rhs))
      values.push(DVPathLam(_ => lhs))
    }
    match
      d_check(
        spec.decode_cases[c],
        DVUniv(spec.decode_level),
        schema_env(types),
        schema_env(values),
        ddim_empty(),
      ) {
      Some(_) => ()
      None => return false
    }
  }
  true
}
